    "segments": [
      {
        "start": 0.0,
        "end": 7.52,
        "text": "Did you know that if you mash one boiled potato with avocado, add eggs, Greek yogurt,"
      },
      {
        "start": 8.08,
        "end": 14.88,
        "text": "baking powder, and salt, and mix the whole lot together until smooth. Then shape it into buns,"
      },
      {
        "start": 15.44,
        "end": 22.16,
        "text": "brush the tops with egg yolk, chuck sesame seeds over, and bake until golden. What you get are"
      },
      {
        "start": 22.16,
        "end": 29.68,
        "text": "incredibly soft fluffy avocado potato buns with zero flour anywhere near them. Click the link in"
