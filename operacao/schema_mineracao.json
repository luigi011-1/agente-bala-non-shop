{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luigi011-1/agente-bala-non-shop/operacao/schema_mineracao.json",
  "title": "Seeds e resultados da mineração pública",
  "description": "Validar seeds usando $defs.seeds; resultado usando $defs.result. URL scope e evidências são validados novamente pelo executável. Observações são atestações auditáveis do pesquisador, não dados inventados nem snippets de buscador. Somente perfil EUA e vídeo Instagram/Facebook atendem à operação; fixture local exige flag de testes explícita.",
  "$defs": {
    "angle": {"enum": ["sea-moss", "fitwell", "auraly", "body-hacks"]},
    "urls": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "format": "uri"}},
    "observation": {
      "type": "object",
      "required": ["subject_url", "source_url", "observed_at", "field", "value", "method", "scope", "verified", "note"],
      "properties": {
        "subject_url": {"type": "string", "format": "uri", "description": "Perfil ao qual se aplica a observação; preferir o URL público canônico."},
        "source_url": {"type": "string", "format": "uri", "description": "Fonte pública oficial Instagram/Facebook que permite verificar a observação."},
        "observed_at": {"type": "string", "format": "date-time"},
        "field": {"enum": ["profile_ai_only", "niche_match"]},
        "value": {"type": "boolean"},
        "method": {"enum": ["visual_audit", "content_audit"]},
        "scope": {"enum": ["all_public_posts", "profile_content"]},
        "verified": {"const": true},
        "note": {"type": "string", "minLength": 1, "description": "Descrever o que foi inspecionado e a cobertura. Não marcar verified sem inspecionar as fontes."},
        "angle": {"$ref": "#/$defs/angle", "description": "Obrigatório para niche_match: ângulo cuja compatibilidade foi auditada."}
      },
      "allOf": [
        {"if": {"properties": {"field": {"const": "profile_ai_only"}}}, "then": {"properties": {"method": {"const": "visual_audit"}, "scope": {"const": "all_public_posts"}}}},
        {"if": {"properties": {"field": {"const": "niche_match"}}}, "then": {"required": ["angle"], "properties": {"method": {"const": "content_audit"}, "scope": {"const": "profile_content"}}}}
      ]
    },
    "seeds": {
      "oneOf": [
        {"$ref": "#/$defs/urls"},
        {"type": "object", "required": ["urls"], "properties": {"urls": {"$ref": "#/$defs/urls"}, "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}}}
      ]
    },
    "evidence": {"type": "object", "required": ["value", "source_url", "observed_at", "method", "excerpt"], "properties": {"source_url": {"type": "string", "format": "uri"}, "observed_at": {"type": "string", "format": "date-time"}, "method": {"type": "string"}, "excerpt": {"type": "string"}}},
    "criterion": {"type": "object", "required": ["status", "evidence"], "properties": {"status": {"enum": ["confirmed", "unknown", "conflict", "rejected"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}},
    "video": {
      "type": "object", "required": ["url", "platform", "title", "profile_url", "status", "criteria", "missing", "blocked"],
      "properties": {
        "url": {"type": "string", "format": "uri"}, "platform": {"enum": ["instagram", "facebook", "fixture"]},
        "title": {"type": "string"}, "profile_url": {"type": ["string", "null"]}, "status": {"enum": ["approved", "candidate", "rejected"]},
        "criteria": {"type": "object", "required": ["posted_at", "views", "profile_created_at", "profile_country", "profile_ai_only", "niche_match"], "additionalProperties": {"$ref": "#/$defs/criterion"}},
        "missing": {"type": "array", "items": {"type": "string"}}, "blocked": {"type": "boolean"}
      }
    },
    "result": {
      "type": "object", "required": ["schema_version", "angle", "status", "started_at", "finished_at", "filters", "limits", "limits_reached", "counts", "test_fixture_mode", "crawler", "approved", "candidates", "rejected", "errors"],
      "properties": {
        "schema_version": {"const": 1}, "angle": {"$ref": "#/$defs/angle"}, "status": {"enum": ["COMPLETE", "PARTIAL", "BLOCKED", "FAILED"]},
        "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
        "filters": {"type": "object"}, "limits": {"type": "object"}, "limits_reached": {"type": "boolean"}, "counts": {"type": "object"},
        "test_fixture_mode": {"type": "boolean"}, "crawler": {"type": "object"},
        "approved": {"type": "array", "items": {"$ref": "#/$defs/video"}}, "candidates": {"type": "array", "items": {"$ref": "#/$defs/video"}}, "rejected": {"type": "array", "items": {"$ref": "#/$defs/video"}}, "errors": {"type": "array"}
      }
    }
  }
}
