{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revisão independente de uma entrega da operação",
  "type": "object",
  "required": ["task_id", "reviewer", "independent", "status", "checks", "findings"],
  "properties": {
    "task_id": {"type": "string"},
    "reviewer": {"const": "bala-revisor"},
    "independent": {"const": true},
    "status": {"enum": ["APPROVED", "CHANGES_REQUIRED", "INCOMPLETE"]},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "result", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["severity", "message", "evidence"],
        "properties": {
          "severity": {"enum": ["BLOCKER", "WARNING"]},
          "message": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
